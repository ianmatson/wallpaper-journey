# Copy this file outside the public repository and set its mode to 0600.
# Use absolute paths. Do not place credentials in this file.

AI_WALLPAPERS_TIME_ZONE=America/Chicago
AI_WALLPAPERS_WORKSPACE_ROOT=/absolute/path/to/wallpaper-journey
AI_WALLPAPERS_REPOSITORY=/absolute/path/to/wallpaper-journey/ai-wallpapers
AI_WALLPAPERS_REQUIRED_ORIGIN=git@github.com:ianmatson/wallpaper-journey.git
AI_WALLPAPERS_GITHUB_REPOSITORY=ianmatson/wallpaper-journey
AI_WALLPAPERS_GITHUB_TOKEN_FILE=/absolute/path/to/wallpaper-journey/config/github-token

AI_WALLPAPERS_NATIVE_ROOT=/absolute/path/to/wallpaper-journey/story/native
AI_WALLPAPERS_STYLE_ROOT=/absolute/path/to/wallpaper-journey/story/style-references
AI_WALLPAPERS_UPSCALED_ROOT=/absolute/path/to/wallpaper-journey/story/upscaled
AI_WALLPAPERS_STAGING_ROOT=/absolute/path/to/wallpaper-journey/story/staging
AI_WALLPAPERS_PRIVATE_ROOT=/absolute/path/to/wallpaper-journey/story/private
AI_WALLPAPERS_INPUT_ROOT=/absolute/path/to/wallpaper-journey/tmp
AI_WALLPAPERS_SEED_IMAGE=/absolute/path/to/wallpaper-journey/seed/digital-alpine-observatory.png

AI_WALLPAPERS_UPSCAYL_MODE=direct
AI_WALLPAPERS_UPSCAYL_EXECUTABLE=/absolute/path/to/upscayl-bin
AI_WALLPAPERS_UPSCAYL_MODELS=/absolute/path/to/wallpaper-journey/upscayl/models
AI_WALLPAPERS_UPSCAYL_MODEL=digital-art-4x
AI_WALLPAPERS_UPSCAYL_SCALE=4
AI_WALLPAPERS_UPSCAYL_GPU_ID=0
AI_WALLPAPERS_UPSCAYL_WORK=/absolute/path/to/wallpaper-journey/upscayl/work
AI_WALLPAPERS_UPSCAYL_OUTPUT=/absolute/path/to/wallpaper-journey/upscayl/output
AI_WALLPAPERS_UPSCALE_TIMEOUT_SECONDS=2700

AI_WALLPAPERS_CONTROL_DIR=/absolute/path/to/wallpaper-journey/control/producer
